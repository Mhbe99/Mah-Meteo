# =============================================================================
# MI LOC — variables d'environnement
# Copier ce fichier vers ".env.local" (jamais commité) et renseigner les valeurs.
# =============================================================================

# --- Envoi d'e-mail (obligatoire) ---------------------------------------------
# Clé API Resend (https://resend.com) utilisée pour envoyer les demandes reçues
# via le formulaire. Ne jamais exposer cette clé côté frontend.
RESEND_API_KEY=

# Adresse e-mail interne MI LOC qui reçoit chaque nouvelle demande de recherche.
CONTACT_EMAIL=

# Adresse d'expédition utilisée par Resend. Doit appartenir à un domaine
# vérifié dans Resend (ex: recherche@mi-loc.fr). À défaut, utiliser l'adresse
# de test fournie par Resend (onboarding@resend.dev) en attendant la
# vérification du domaine.
RESEND_FROM_EMAIL=

# --- Anti-spam (optionnel) ----------------------------------------------------
# Cloudflare Turnstile — si les deux variables sont renseignées, la validation
# Turnstile est activée automatiquement sur le formulaire. Laisser vide pour
# désactiver (le honeypot + la limitation de requêtes restent actifs).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
